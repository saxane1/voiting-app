# PSU Online Voting System — backend environment template.
#
# Copy to .env and fill in real values. .env is gitignored; this file is not, so
# NEVER put a real secret, password or connection string here.
# Every variable below is validated at boot by src/config/env.js — a missing or
# malformed required value exits the process with an explanation.

# development | test | production
NODE_ENV=development
PORT=5000

# PostgreSQL on Neon — use the POOLED connection string.
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# Comma-separated list of allowed browser origins (Next.js dev + deployed app).
# Consumed by cors and by socket.io.
CORS_ORIGIN=http://localhost:3000

# Public URL of the FRONTEND, used to build links in outgoing email.
# Optional: defaults to the first CORS_ORIGIN entry. Set it when the
# browser-facing URL differs from the allowed origin list (e.g. behind a CDN).
# APP_URL=https://vote.psu.edu.so

# ---------------------------------------------------------------------------
# Bootstrap admin — used ONLY by prisma/seed.js (npm run seed).
#
# This address is the system's ROOT OF TRUST. The seeded account is flagged
# isRoot = true and can never be deactivated by anyone, including itself, so the
# system can never be locked out of its own administration. Exactly one account
# may hold that flag — enforced by a partial unique index on users(is_root).
#
# The seed is idempotent (upsert on this email), so re-running it never creates a
# second root. Changing this value after the first seed will make the seed FAIL
# rather than silently move the root; transfer root deliberately if you mean to.
# ---------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME="PSU Election Admin"

# ---------------------------------------------------------------------------
# Auth (B1) — passwordless OTP -> JWT
# ---------------------------------------------------------------------------

# Minimum 32 characters each, and they MUST differ from one another: reusing one
# secret would let an access token be replayed as a refresh token.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-me-with-a-DIFFERENT-32-plus-character-secret

# jsonwebtoken duration strings ("15m", "7d") or a number of seconds.
ACCESS_TTL=15m
REFRESH_TTL=7d

OTP_TTL_MIN=10
OTP_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# Email — generic SMTP, so moving between providers is an env-only change.
# Use a transactional provider (Brevo / SendGrid / SES) in production; Gmail
# throttles at election-day volume.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password-or-api-key
# Plain address, or "Display Name <address>".
SMTP_FROM="PSU Voting <no-reply@example.com>"
