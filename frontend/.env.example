# Origin of the Express backend. The axios instance appends /api itself,
# so this is the ORIGIN only — no trailing slash, no /api.
# NEXT_PUBLIC_ is required: the token store and axios both run in the browser.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Number of digits in the emailed OTP. Mirrors the backend generator
# (backend/src/utils/otp.js); the UI uses it to draw the code boxes.
NEXT_PUBLIC_OTP_LENGTH=6
